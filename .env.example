# Prisma
# Default provider configured in prisma/schema.prisma: postgresql
DATABASE_URL=postgresql://user:password@localhost:5432/eclipse

# Email auth with Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
AUTH_EMAIL_NO_REPLY_FROM=Eclipse <no-reply@your-domain.com>
AUTH_EMAIL_REPLY_TO=support@your-domain.com

# Optional fallback / general sender
AUTH_EMAIL_FROM=Eclipse <auth@your-domain.com>

# Future OAuth providers (not used yet)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationCodePurpose {
  EMAIL_VERIFICATION
  LOGIN_2FA
  PASSWORD_RESET
}

enum AuthProvider {
  CREDENTIALS
  GITHUB
  GOOGLE
  GITLAB
}

enum AiProvider {
  CLAUDE
  GPT
  OPENROUTER
  ZAI
  XAI
  GPT_SUBSCRIPTION
}

enum ProjectStatus {
  ACTIVE
  AT_RISK
  COMPLETED
}

enum IssueSeverity {
  IMPORTANT
  MEDIUM
  LOW
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MailDirection {
  INBOUND
  OUTBOUND
}

enum MailStatus {
  DRAFT
  SENT
  RECEIVED
  ARCHIVED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum AgentSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  username              String?                @unique
  passwordHash          String?
  emailVerifiedAt       DateTime?
  avatarUrl             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              AuthSession[]
  verificationCodes     VerificationCode[]
  accounts              AuthAccount[]
  aiProviderConnections AiProviderConnection[]
  projects              Project[]
  issues                Issue[]
  mails                 Mail[]
  agents                Agent[]
  agentSessions         AgentSession[]

  @@map("users")
}

model Project {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?
  externalUrl String?
  status      ProjectStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues      Issue[]
  mails       Mail[]
  sessions    AgentSession[]

  @@index([userId, status])
  @@map("projects")
}

model Issue {
  id          String        @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String?
  severity    IssueSeverity @default(MEDIUM)
  status      IssueStatus   @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([projectId])
  @@map("issues")
}

model Mail {
  id          String        @id @default(cuid())
  userId      String
  projectId   String?
  fromAddress String
  toAddresses String[]
  subject     String
  body        String
  direction   MailDirection
  status      MailStatus    @default(DRAFT)
  sentAt      DateTime?
  receivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([projectId])
  @@map("mails")
}

model Agent {
  id           String         @id @default(cuid())
  userId       String
  name         String
  defaultModel String
  status       AgentStatus    @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     AgentSession[]

  @@index([userId, status])
  @@map("agents")
}

model AgentSession {
  id          String             @id @default(cuid())
  userId      String
  agentId     String
  projectId   String?
  description String
  model       String
  status      AgentSessionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now())
  endedAt     DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([agentId])
  @@index([projectId])
  @@map("agent_sessions")
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model VerificationCode {
  id         String                  @id @default(cuid())
  userId     String
  purpose    VerificationCodePurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                @default(now())
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([consumedAt])
  @@map("verification_codes")
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_accounts")
}

model AiProviderConnection {
  id              String     @id @default(cuid())
  userId          String
  provider        AiProvider
  encryptedApiKey String?
  keyHint         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("ai_provider_connections")
}
